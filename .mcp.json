{
  "mcpServers": {
    "evavo-local-image-generator": {
      "command": "python",
      "args": ["-m", "evavo_local_image_generator.mcp_server", "--transport", "stdio"],
      "env": {
        "COMFYUI_ENDPOINT": "http://127.0.0.1:8188",
        "EVAVO_AUTO_PROVISION_COMFYUI": "1",
        "EVAVO_AUTO_PROVISION_CHECKPOINT": "1",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "EVAVO native ComfyUI image-generation MCP v2 server with constrained local auto-provisioning"
    }
  }
}
