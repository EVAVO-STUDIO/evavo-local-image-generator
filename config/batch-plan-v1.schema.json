{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.local/schemas/batch-plan-v1.schema.json",
  "title": "EVAVO Image Batch Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "endpoint": {"type": "string", "minLength": 1},
    "concurrency": {"type": "integer", "minimum": 1, "maximum": 8, "default": 1},
    "wait": {"type": "boolean", "default": true},
    "wait_timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400, "default": 900},
    "output_dir": {"type": "string"},
    "defaults": {"$ref": "#/$defs/options"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "negative_prompt": {"type": "string"},
        "quality_profile": {"type": "string", "enum": ["draft", "quality", "detail", "hero", "euler_reference", "legacy_768_reference", "custom"]},
        "width": {"type": "integer", "minimum": 64, "maximum": 4096},
        "height": {"type": "integer", "minimum": 64, "maximum": 4096},
        "steps": {"type": "integer", "minimum": 1, "maximum": 200},
        "cfg_scale": {"type": "number", "minimum": 0, "maximum": 100},
        "sampler_name": {"type": "string", "minLength": 1},
        "scheduler": {"type": "string", "minLength": 1},
        "denoise": {"type": "number", "minimum": 0, "maximum": 1},
        "upscale_factor": {"type": "number", "minimum": 1, "maximum": 4},
        "second_pass_steps": {"type": "integer", "minimum": 0, "maximum": 100},
        "second_pass_cfg_scale": {"type": "number", "minimum": 0, "maximum": 100},
        "second_pass_sampler_name": {"type": "string", "minLength": 1},
        "second_pass_scheduler": {"type": "string", "minLength": 1},
        "second_pass_denoise": {"type": "number", "minimum": 0, "maximum": 1},
        "latent_upscale_method": {"type": "string", "minLength": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "lora_name": {"type": "string", "minLength": 1},
        "lora_model_strength": {"type": "number", "minimum": -4, "maximum": 4},
        "lora_clip_strength": {"type": "number", "minimum": -4, "maximum": 4},
        "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "workflow_path": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "oneOf": [
        {"required": ["prompt"], "not": {"required": ["prompt_spec"]}},
        {"required": ["prompt_spec"], "not": {"required": ["prompt"]}}
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "prompt": {"type": "string", "minLength": 1},
        "prompt_spec": {"type": "object"},
        "options": {"$ref": "#/$defs/options"},
        "output_subdir": {"type": "string", "minLength": 1}
      }
    }
  }
}
