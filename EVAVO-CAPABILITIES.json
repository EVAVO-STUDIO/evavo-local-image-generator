{
  "schema_version": 1,
  "capability_id": "evavo.local.image-generation",
  "repository": "EVAVO-STUDIO/evavo-local-image-generator",
  "production_contract": {
    "owned_modality": "image",
    "backend": "native-comfyui",
    "mock_is_renderer": false,
    "default_comfyui_endpoint": "http://127.0.0.1:8188",
    "canonical_endpoint_environment": "COMFYUI_ENDPOINT",
    "legacy_endpoint_environment": "EVAVO_COMFYUI_ENDPOINT"
  },
  "interfaces": {
    "cli": {
      "controller": "evavo.py",
      "verify": "python evavo.py verify --full",
      "strict_windows_verify": "python evavo.py verify --full --require-powershell",
      "repair": "python agent-doctor.py --repair --provision",
      "generate": "python evavo.py generate --prompts \"your prompt\" --project demo --wait",
      "status": "python evavo.py status"
    },
    "python": {
      "backend": "evavo_local_image_generator.backends.ComfyUIBackend",
      "wrapper": "evavo-wrapper.py",
      "owned_generation_modalities": ["image"]
    },
    "mcp": {
      "sdk": "mcp[cli]>=2,<3",
      "stdio": "python -m evavo_local_image_generator.mcp_server --transport stdio",
      "streamable_http": {
        "default_url": "http://127.0.0.1:8765/mcp",
        "loopback_only": true,
        "purpose": ["local MCP clients", "integration testing", "private target for OpenAI Secure MCP Tunnel"]
      },
      "owned_generation_modalities": ["image"],
      "tools": [
        "provision_backend", "ensure_backend", "health_check", "discover_backends", "list_checkpoints",
        "model_inventory", "workflow_preflight", "generate_image", "generate_batch", "generation_status",
        "collect_generation", "read_output_image", "task_history", "task_statistics", "stop_managed_backend"
      ]
    },
    "chatgpt": {
      "transport": "openai-secure-mcp-tunnel",
      "direct_localhost_supported": false,
      "runbook": "CHATGPT-TUNNEL.md",
      "private_mcp_default": "http://127.0.0.1:8765/mcp"
    },
    "claude": {"transport": "stdio-mcp", "installer": "INSTALL-CLAUDE-MCP.ps1"},
    "http_gateway": {
      "optional": true,
      "default_url": "http://127.0.0.1:8000",
      "loopback_only": true,
      "cors_default": "disabled",
      "cors_wildcard_allowed": false,
      "structured_config_errors": true,
      "max_request_bytes_default": 1048576,
      "max_request_bytes_hard_cap": 16777216,
      "max_project_chars_default": 128,
      "request_workflow_path_default_allowed": false,
      "request_workflow_path_requires_root": true,
      "task_state_cross_process_lock": true,
      "task_id_allocation_interprocess_atomic": true,
      "single_live_gateway_per_task_state": true,
      "state_in_use_error": "GATEWAY_STATE_IN_USE",
      "corrupt_task_state_fail_closed": true,
      "image_endpoint": "/generate/image",
      "owned_generation_modalities": ["image"],
      "auxiliary_delegation": {
        "readiness_endpoint": "/services",
        "fail_closed": true,
        "routes": {
          "/generate/video": {"accepted_status": 202, "ownership": "delegated", "provider": "EVAVO Video Studio or explicitly configured reviewed provider"},
          "/generate/audio": {"accepted_status": 202, "ownership": "delegated", "provider": "explicitly configured reviewed Audio Studio provider"},
          "/generate/3d": {"accepted_status": 202, "ownership": "delegated", "provider": "token-gated EVAVO 3D Studio worker"}
        }
      }
    }
  },
  "native_comfyui_api": ["GET /system_stats", "GET /object_info[/<node>]", "POST /prompt", "GET /history/<prompt_id>", "GET /view"],
  "model_inventory_categories": ["checkpoints", "loras", "vae", "controlnet", "diffusion_models", "text_encoders", "clip_vision", "upscale_models"],
  "automation": {
    "windows_setup": ".\\UPDATE-AND-VERIFY-EVAVO.ps1",
    "auto_discover_comfyui": true,
    "auto_start_native_comfyui": true,
    "optional_runtime_provisioning": true,
    "optional_checkpoint_repair": true,
    "shared_model_roots": true,
    "custom_workflow_preflight": true,
    "wait_and_download": true,
    "shared_task_history": true,
    "native_mcp_image_content": true,
    "gateway_auxiliary_provider_readiness": true
  },
  "security": {
    "public_bind_by_default": false,
    "gateway_wildcard_cors_by_default": false,
    "gateway_request_preparse_size_limit": true,
    "gateway_chunked_request_limit": true,
    "gateway_request_workflow_path_default_allowed": false,
    "gateway_request_workflow_root_confinement": true,
    "gateway_structured_config_errors": true,
    "gateway_task_state_corruption_fail_closed": true,
    "gateway_task_id_interprocess_atomic": true,
    "gateway_task_state_single_live_owner": true,
    "service_manager_state_corruption_fail_closed": true,
    "service_manager_provider_secret_plaintext_in_state": false,
    "broad_python_process_kill": false,
    "managed_process_identity_verification": true,
    "user_managed_comfyui_never_killed": true,
    "atomic_output_downloads": true,
    "authorized_mcp_image_reads": true,
    "provider_shell_execution": false,
    "provider_receipt_required": true,
    "provider_output_confinement": true,
    "provider_receipt_digest_verification_when_supplied": true,
    "chatgpt_tunnel_release_sha256_verification": true,
    "chatgpt_tunnel_executable_sha256_verification": true,
    "chatgpt_tunnel_dpapi_key_storage": true,
    "plaintext_tunnel_key_in_repo_or_startup": false,
    "arbitrary_model_url_from_mcp_tool": false
  },
  "not_owned_production_modalities": ["video", "audio", "3d", "particles", "general-text", "dedicated-pbr-textures"],
  "delegated_gateway_modalities": ["video", "audio", "3d"],
  "source_of_truth": [
    "README.md", "CLAUDE.md", "AGENT-INTEGRATION.md", "AGENT-RECOVERY.md", "AUTOMATION-GUIDE.md",
    "OPERATIONS-GUIDE.md", "DEPLOYMENT-CHECKLIST.md", "GATEWAY-INTEGRATION-GUIDE.md", "GATEWAY-AUX-PROVIDERS.md",
    "PROVIDER-INTEGRATION-GUIDE.md", "CHATGPT-TUNNEL.md", "QUICK-REFERENCE.md", ".evavo/capabilities.json"
  ]
}
