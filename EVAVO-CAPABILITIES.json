{
  "schema_version": 1,
  "capability_id": "evavo.local.image-generation",
  "repository": "EVAVO-STUDIO/evavo-local-image-generator",
  "production_contract": {
    "owned_modality": "image",
    "backend": "native-comfyui",
    "mock_is_renderer": false,
    "default_comfyui_endpoint": "http://127.0.0.1:8188",
    "canonical_endpoint_environment": "COMFYUI_ENDPOINT",
    "legacy_endpoint_environment": "EVAVO_COMFYUI_ENDPOINT"
  },
  "interfaces": {
    "cli": {
      "controller": "evavo.py",
      "verify": "python evavo.py verify --full",
      "strict_windows_verify": "python evavo.py verify --full --require-powershell",
      "repair": "python agent-doctor.py --repair --provision",
      "comfyui_dependency_repair": "python repair-comfyui-dependencies.py",
      "real_generation_smoke": "python real-generation-smoke.py --json",
      "generate": "python evavo.py generate --prompts \"your prompt\" --project demo --wait",
      "status": "python evavo.py status"
    },
    "python": {
      "backend": "evavo_local_image_generator.backends.ComfyUIBackend",
      "repair_bridge": "evavo_local_image_generator.comfyui_repair.repair_backend_dependencies",
      "wrapper": "evavo-wrapper.py",
      "owned_generation_modalities": ["image"]
    },
    "mcp": {
      "sdk": "mcp[cli]>=2,<3",
      "production_entry_module": "evavo_local_image_generator.mcp_entry",
      "implementation_module": "evavo_local_image_generator.mcp_server",
      "stdio": "python -m evavo_local_image_generator.mcp_entry --transport stdio",
      "streamable_http": {
        "default_url": "http://127.0.0.1:8765/mcp",
        "loopback_only": true,
        "purpose": ["local MCP clients", "integration testing", "private target for OpenAI Secure MCP Tunnel"]
      },
      "owned_generation_modalities": ["image"],
      "client_parity": {
        "claude": "stdio-mcp",
        "chatgpt": "same private MCP through OpenAI Secure MCP Tunnel",
        "same_tool_implementation": true
      },
      "file_policy": {
        "default_output_root_environment": "EVAVO_GENERATION_OUTPUT_DIR",
        "additional_output_roots_environment": "EVAVO_MCP_OUTPUT_ROOTS",
        "arbitrary_output_directories_allowed": false,
        "owner_workflow_environment": "EVAVO_COMFYUI_WORKFLOW",
        "tool_workflow_paths_default_allowed": false,
        "tool_workflow_path_opt_in_environment": "EVAVO_MCP_ALLOW_WORKFLOW_PATHS",
        "tool_workflow_root_environment": "EVAVO_MCP_WORKFLOW_ROOT",
        "ordinary_file_identity_required": true,
        "additional_output_roots_must_be_writable": true,
        "image_signature_validation": true,
        "persistent_profiles_keep_non_secret_policy": true,
        "validated_before_profile_persistence": true,
        "validated_at_production_server_entry": true
      },
      "invalid_request_preflight_before_backend_work": true,
      "startup_dependency_repair": {
        "tool": "repair_backend_dependencies",
        "normal_admission_category": "missing_dependency",
        "custom_node_core_sync_allowed": false,
        "arbitrary_package_input_allowed": false,
        "arbitrary_python_path_allowed": false,
        "arbitrary_comfyui_path_allowed": false,
        "uses_checkout_requirements": true,
        "uses_selected_comfyui_python": true,
        "shell_execution": false,
        "structured_receipt": true,
        "force_sync_owner_environment": "EVAVO_ALLOW_FORCED_DEPENDENCY_REPAIR",
        "force_sync_requires_owner_authorization": true
      },
      "generation_status": {
        "source": ["GET /api/jobs/<job_id>", "GET /history/<prompt_id>", "GET /queue"],
        "normalized_states": ["queued", "running", "completed", "failed", "cancelled", "unknown"],
        "failed_history_updates_shared_task_history": true,
        "missing_prompt_is_unknown_not_queued": true
      },
      "generation_cancellation": {
        "tool": "cancel_generation",
        "preferred_endpoint": "POST /api/jobs/<job_id>/cancel",
        "idempotent_terminal_or_unknown_noop": true,
        "legacy_pending_queue_delete": true,
        "legacy_running_broad_interrupt_allowed": false
      },
      "tools": [
        "provision_backend", "ensure_backend", "open_comfyui_ui", "diagnose_backend", "last_startup_failure", "repair_backend_dependencies", "health_check",
        "discover_backends", "list_checkpoints", "model_inventory", "workflow_preflight", "generate_image",
        "generate_batch", "generation_status", "cancel_generation", "collect_generation", "read_output_image",
        "task_history", "task_statistics", "stop_managed_backend"
      ],
      "comfyui_ui_presentation": {
        "tool": "open_comfyui_ui",
        "requires_native_readiness": true,
        "opens_on_connected_workstation": true,
        "url_policy": "plain-loopback-http-only",
        "direct_windows_launcher": "OPEN-COMFYUI.ps1"
      }
    },
    "chatgpt": {
      "transport": "openai-secure-mcp-tunnel",
      "direct_localhost_supported": false,
      "runbook": "CHATGPT-TUNNEL.md",
      "private_mcp_default": "http://127.0.0.1:8765/mcp",
      "shared_mcp_tool_parity_with_claude": true
    },
    "claude": {
      "transport": "stdio-mcp",
      "installer": "INSTALL-CLAUDE-MCP.ps1",
      "shared_mcp_tool_parity_with_chatgpt": true
    },
    "http_gateway": {
      "optional": true,
      "default_url": "http://127.0.0.1:8000",
      "loopback_only": true,
      "cors_default": "disabled",
      "cors_wildcard_allowed": false,
      "structured_config_errors": true,
      "max_request_bytes_default": 1048576,
      "max_request_bytes_hard_cap": 16777216,
      "max_project_chars_default": 128,
      "request_workflow_path_default_allowed": false,
      "request_workflow_path_requires_root": true,
      "task_state_cross_process_lock": true,
      "task_id_allocation_interprocess_atomic": true,
      "single_live_gateway_per_task_state": true,
      "state_in_use_error": "GATEWAY_STATE_IN_USE",
      "corrupt_task_state_fail_closed": true,
      "result_file_identity_required": true,
      "image_endpoint": "/generate/image",
      "owned_generation_modalities": ["image"],
      "auxiliary_delegation": {
        "readiness_endpoint": "/services",
        "fail_closed": true,
        "routes": {
          "/generate/video": {"accepted_status": 202, "ownership": "delegated", "provider": "EVAVO Video Studio or explicitly configured reviewed provider"},
          "/generate/audio": {"accepted_status": 202, "ownership": "delegated", "provider": "explicitly configured reviewed Audio Studio provider"},
          "/generate/3d": {"accepted_status": 202, "ownership": "delegated", "provider": "token-gated EVAVO 3D Studio worker"}
        }
      }
    }
  },
  "native_comfyui_api": [
    "GET /system_stats", "GET /object_info[/<node>]", "POST /prompt", "GET /api/jobs/<job_id>",
    "POST /api/jobs/<job_id>/cancel", "GET /history/<prompt_id>", "GET /queue", "POST /queue", "GET /view"
  ],
  "model_inventory_categories": ["checkpoints", "loras", "vae", "controlnet", "diffusion_models", "text_encoders", "clip_vision", "upscale_models"],
  "automation": {
    "windows_setup": ".\\UPDATE-AND-VERIFY-EVAVO.ps1",
    "auto_discover_comfyui": true,
    "auto_start_native_comfyui": true,
    "optional_runtime_provisioning": true,
    "bounded_dependency_repair": true,
    "dependency_repair_requires_structured_evidence_by_default": true,
    "forced_dependency_repair_requires_owner_authorization": true,
    "optional_checkpoint_repair": true,
    "shared_model_roots": true,
    "custom_workflow_preflight": true,
    "wait_and_download": true,
    "shared_task_history": true,
    "native_mcp_image_content": true,
    "gateway_auxiliary_provider_readiness": true,
    "persistent_mcp_file_policy": true,
    "normalized_prompt_status": true,
    "targeted_generation_cancellation": true,
    "bounded_startup_diagnostics": true,
    "real_generation_smoke_required_by_windows_setup": true,
    "simulator_tests_do_not_satisfy_production_readiness": true
  },
  "security": {
    "public_bind_by_default": false,
    "gateway_wildcard_cors_by_default": false,
    "gateway_request_preparse_size_limit": true,
    "gateway_chunked_request_limit": true,
    "gateway_request_workflow_path_default_allowed": false,
    "gateway_request_workflow_root_confinement": true,
    "gateway_result_symlink_or_parent_redirection_rejected": true,
    "gateway_structured_config_errors": true,
    "gateway_task_state_corruption_fail_closed": true,
    "gateway_task_id_interprocess_atomic": true,
    "gateway_task_state_single_live_owner": true,
    "service_manager_state_corruption_fail_closed": true,
    "service_manager_state_interprocess_lock": true,
    "service_manager_lifecycle_interprocess_lock": true,
    "service_manager_provider_secret_plaintext_in_state": false,
    "mcp_tool_workflow_path_default_allowed": false,
    "mcp_tool_workflow_root_confinement": true,
    "mcp_output_directory_root_confinement": true,
    "mcp_output_symlink_or_parent_redirection_rejected": true,
    "mcp_image_signature_validation": true,
    "mcp_invalid_file_or_wait_policy_preflight": true,
    "mcp_profile_policy_validated_before_persistence": true,
    "mcp_production_entry_policy_validation": true,
    "mcp_failed_prompt_not_reported_as_queued": true,
    "mcp_targeted_cancel_preferred": true,
    "mcp_legacy_running_broad_interrupt_allowed": false,
    "mcp_dependency_repair_arbitrary_package_allowed": false,
    "mcp_dependency_repair_arbitrary_python_path_allowed": false,
    "mcp_dependency_repair_arbitrary_comfyui_path_allowed": false,
    "mcp_dependency_repair_custom_node_core_sync_allowed": false,
    "mcp_dependency_repair_shell_execution": false,
    "mcp_force_sync_requires_owner_authorization": true,
    "broad_python_process_kill": false,
    "managed_process_identity_verification": true,
    "user_managed_comfyui_never_killed": true,
    "atomic_output_downloads": true,
    "authorized_mcp_image_reads": true,
    "provider_shell_execution": false,
    "provider_receipt_required": true,
    "provider_output_confinement": true,
    "provider_source_and_destination_symlink_rejection": true,
    "provider_receipt_digest_verification_when_supplied": true,
    "chatgpt_tunnel_release_sha256_verification": true,
    "chatgpt_tunnel_executable_sha256_verification": true,
    "chatgpt_tunnel_dpapi_key_storage": true,
    "plaintext_tunnel_key_in_repo_or_startup": false,
    "arbitrary_model_url_from_mcp_tool": false
  },
  "not_owned_production_modalities": ["video", "audio", "3d", "particles", "general-text", "dedicated-pbr-textures"],
  "delegated_gateway_modalities": ["video", "audio", "3d"],
  "source_of_truth": [
    "AGENTS.md", "README.md", "CLAUDE.md", "AGENT-INTEGRATION.md", "AGENT-RECOVERY.md", "COMFYUI-STARTUP-DIAGNOSTICS.md", "AUTOMATION-GUIDE.md",
    "OPERATIONS-GUIDE.md", "DEPLOYMENT-CHECKLIST.md", "GATEWAY-INTEGRATION-GUIDE.md", "GATEWAY-AUX-PROVIDERS.md",
    "PROVIDER-INTEGRATION-GUIDE.md", "CHATGPT-TUNNEL.md", "QUICK-REFERENCE.md", ".evavo/capabilities.json"
  ]
}
